' =====================================================
' 融资租赁核心业务数据模型 —— 实体定义片段
'
' 【唯一真源】35 个实体的字段定义只在本文件出现一次。
'   主模型与四个视图均 !include 本文件，改字段只改这里。
'
' 【实体编号】实体标题带 1–35 序号，编号 = 业务办理顺序：
'   租前 1–5      客户 / 经营主体 / 授信额度 / 额度占用流水 / 项目方案
'   租中 6–19     合同 / 参与方 / 从合同 / 保证金 / 费用 / 租金版本 /
'                 租金明细 / 放款 / 标的物三表 / 担保物 / 担保关系 / 变更单
'   租后 20–33    应收 / 罚息 / 风险分类 / 催收 / 收款 / 核销 / 退款 /
'                 结清 / 开票 / 发票明细 / 摊销 / 折旧 / 凭证 / 分录
'   贯穿层 34–35  审批申请单 / 审批单据明细
'
' 【本文件不含关系线】关系由各引入方自行声明：
'   主模型 融资租赁数据模型.puml —— 声明全部关系
'   视图1..4                    —— 只声明本视图关心的关系，
'                                  再用 hide @unlinked 隐去未被引用的实体
'
' 【不要给本文件加 @startuml/@enduml】它是片段，不能单独渲染。
'
' 【图例】
'   <<PK>> 主键   <<FK>> 外键   <<BK>> 业务编号（唯一索引，不作关联键）
'   <<派生>> 由其他字段计算得出，非录入项
'   <<不变量>> 内核不变量字段，全表穿透，不可后补
'
' 【全表公共字段】以下字段所有业务表均有，各实体内不再重复列出：
'   org_id <<不变量>>       法人/分公司主体，牌照与合规边界
'   biz_line <<不变量>>     业务条线 FL/OL/FAC/LOAN
'   业务日期 <<不变量>>     记账与计息基准日，不取 now()，支持历史重跑
'   创建人/创建时间/更新人/更新时间
' =====================================================

skinparam shadowing false
skinparam classBackgroundColor #F4F4F4
skinparam classBorderColor #999999
skinparam classHeaderBackgroundColor #E6E6E6
skinparam ArrowColor #666666
skinparam packageStyle rectangle
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #BBBBBB

' =====================================================
' 一、主体与授信（贷前 1–5）
' =====================================================
package "主体与授信" {

  entity "1. 客户（承租人、买方、卖方等）" as customer {
    id <<PK>>
    --
    客户名称
    统一社会信用代码 <<BK>>
    客户类型
    集团客户id <<FK>>
    状态
  }

  entity "2. 经营主体（出租方）" as lessor {
    id <<PK>>
    --
    主体名称
    统一社会信用代码 <<BK>>
    持有牌照清单
    所属业务部门
    状态
  }

  entity "3. 授信额度" as credit {
    id <<PK>>
    客户id <<FK>>
    --
    额度编号 <<BK>>
    授信品种
    适用业务条线
    授信金额
    已用金额 <<派生>>
    预占金额 <<派生>>
    额度类型
    生效日
    到期日
    状态
  }

  entity "4. 额度占用流水" as credit_occupy {
    id <<PK>>
    额度id <<FK>>
    来源单据类型
    来源单据id <<FK>>
    --
    变动类型
    变动金额
    变动后已用金额
    变动后预占金额
    发生日
    冲销标记
  }

  entity "5. 项目方案" as plan {
    id <<PK>>
    客户id <<FK>>
    额度id <<FK>>
    --
    方案编号 <<BK>>
    业务模式
    融资金额
    融资时间
    计算方案编码
    计算方案版本
    状态
  }
}

' =====================================================
' 二、合同与放款（贷中 6–19 前半）
' =====================================================
package "合同与放款" {

  entity "6. 主合同" as contract {
    id <<PK>>
    承租方id <<FK>>
    出租方id <<FK>>
    项目方案id <<FK>>
    额度id <<FK>>
    --
    合同编号 <<BK>>
    合同金额
    币种
    起租日
    到期日
    其他合同要素
    当前生效租金版本 <<FK>>
    状态
  }

  entity "7. 合同参与方" as contract_party {
    id <<PK>>
    合同id <<FK>>
    客户id <<FK>>
    --
    参与角色
    备注
  }

  entity "8. 从合同" as sub_contract {
    id <<PK>>
    合同id <<FK>>
    --
    合同编号 <<BK>>
    合同金额
    合同类型
    合同签订日
    状态
  }

  entity "13. 放款" as loan {
    id <<PK>>
    合同id <<FK>>
    项目方案id <<FK>>
    承租方id <<FK>>
    --
    放款编号 <<BK>>
    放款金额
    实付金额 <<派生>>
    币种
    投放时间
    起租日
    状态
  }

  entity "19. 合同变更单" as change_order {
    id <<PK>>
    合同id <<FK>>
    --
    变更单编号 <<BK>>
    变更类型
    变更生效日
    变更前租金版本 <<FK>>
    变更后租金版本 <<FK>>
    变更前要素快照
    变更后要素快照
    状态
  }
}

' =====================================================
' 三、计划与租金（贷中 9–12）
' =====================================================
package "计划与租金" {

  entity "9. 保证金计划" as deposit_plan {
    id <<PK>>
    归属类型
    归属id <<FK>>
    --
    保证金比例
    保证金金额
    计划收取日
    是否内扣
    退还方式
  }

  entity "10. 费用计划" as fee_plan {
    id <<PK>>
    归属类型
    归属id <<FK>>
    --
    费用类型
    费用金额
    计划收取日
    税率
    是否内扣
  }

  entity "11. 租金表版本" as rent_version {
    id <<PK>>
    归属类型
    归属id <<FK>>
    变更单id <<FK>>
    --
    版本号
    版本状态
    生效日
    失效日
    计算方案编码
    计算方案版本
    计算入参快照
    配置包版本
    试算指标
  }

  entity "12. 租金表明细" as rent_line {
    id <<PK>>
    租金版本id <<FK>>
    --
    期次
    款项类型
    计息起日
    计息止日
    收取日期
    本金金额
    利息金额
    剩余本金
  }
}

' =====================================================
' 四、标的物与担保（贷中 14–18）
' =====================================================
package "标的物与担保" {

  entity "14. 标的物（主表）" as subject_matter {
    id <<PK>>
    合同id <<FK>>
    取得合同id <<FK>>
    --
    编号 <<BK>>
    标的物大类
    名称
    原价值
    现价值
    权属状态
    状态
  }

  entity "15. 标的物—租赁物" as sm_lease {
    标的物id <<PK,FK>>
    --
    设备类型
    规格型号
    出厂编号
    安放地点
    投保状态
    抵押登记状态
  }

  entity "16. 标的物—受让应收账款" as sm_receivable {
    标的物id <<PK,FK>>
    --
    原始债务人id <<FK>>
    基础合同编号
    账款到期日
    确权状态
  }

  entity "17. 担保物" as collateral {
    id <<PK>>
    标的物id <<FK>>
    --
    编号 <<BK>>
    担保物类型
    评估价值
    评估日
    权证号
    状态
  }

  entity "18. 担保关系" as guarantee {
    id <<PK>>
    合同id <<FK>>
    担保物id <<FK>>
    保证人id <<FK>>
    --
    担保方式
    担保金额
    担保顺位
    担保起止日
    状态
  }
}

' =====================================================
' 五、应收与逾期（贷后 20–23）
' =====================================================
package "应收与逾期" {

  entity "20. 应收计划明细" as receivable {
    id <<PK>>
    合同id <<FK>>
    放款id <<FK>>
    租金版本id <<FK>>
    还款人id <<FK>>
    --
    期次
    款项类型
    应收金额
    应收日期
    已核销金额 <<派生>>
    减免金额
    收取状态
    结清日 <<派生>>
    逾期天数 <<派生>>
    版本失效标记
  }

  entity "21. 逾期罚息计提" as penalty {
    id <<PK>>
    应收id <<FK>>
    --
    计提日
    计提基数
    罚息率
    本次计提额
    累计计提额
    累计已收额 <<派生>>
    减免额
  }

  entity "22. 风险分类记录" as risk_class {
    id <<PK>>
    合同id <<FK>>
    --
    分类日
    最长逾期天数
    五级分类
    分类调整原因
    IFRS9 阶段
    减值准备金额
    是否人工调整
  }

  entity "23. 催收记录" as collection {
    id <<PK>>
    合同id <<FK>>
    经办人id <<FK>>
    --
    催收日
    催收方式
    催收结果
    承诺还款日
    下次跟进日
  }
}

' =====================================================
' 六、收款与结算（贷后 24–29）
' =====================================================
package "收款与结算" {

  entity "24. 收款单" as payment {
    id <<PK>>
    付款人id <<FK>>
    合同id <<FK>>
    --
    收款单编号 <<BK>>
    银行流水号 <<BK>>
    到账金额
    到账日
    已核销金额 <<派生>>
    未核销余额 <<派生>>
    收款方式
    认领状态
    状态
  }

  entity "25. 核销明细" as allocation {
    id <<PK>>
    收款单id <<FK>>
    应收id <<FK>>
    罚息计提id <<FK>>
    --
    核销金额
    核销日
    核销顺序
    冲销标记
    被冲销明细id <<FK>>
  }

  entity "26. 退款单" as refund {
    id <<PK>>
    收款单id <<FK>>
    收款人id <<FK>>
    --
    退款单编号 <<BK>>
    退款类型
    退款金额
    退款日
    状态
  }

  entity "27. 结清单" as settlement {
    id <<PK>>
    合同id <<FK>>
    --
    结清单编号 <<BK>>
    结清类型
    结清基准日
    剩余本金
    未收利息
    违约金或补偿金
    留购价款
    保证金抵扣
    结清总额
    状态
  }

  entity "28. 开票信息" as invoice {
    id <<PK>>
    合同id <<FK>>
    购买方id <<FK>>
    --
    发票号码 <<BK>>
    发票类型
    开票日期
    价税合计
    不含税金额
    税额
    红冲标记
    被红冲发票id <<FK>>
    状态
  }

  entity "29. 发票明细行" as invoice_line {
    id <<PK>>
    发票id <<FK>>
    应收id <<FK>>
    --
    货物或服务名称
    金额
    税率
    税额
  }
}

' =====================================================
' 七、账务核算（贷后 30–33）
' =====================================================
package "账务核算" {

  entity "30. 摊销区间" as amortization {
    id <<PK>>
    合同id <<FK>>
    放款id <<FK>>
    租金版本id <<FK>>
    --
    区间起日
    区间止日
    日均摊销本金
    日均摊销利息
    区间本金合计
    区间利息合计
    未实现融资收益余额
    是否已过账
  }

  entity "31. 资产折旧" as depreciation {
    id <<PK>>
    标的物id <<FK>>
    --
    折旧期间
    折旧方法
    本期折旧额
    累计折旧额
    账面净值
  }

  entity "32. 凭证" as voucher {
    id <<PK>>
    合同id <<FK>>
    来源单据类型
    来源单据id <<FK>>
    --
    凭证编号 <<BK>>
    记账日期
    会计期间
    凭证摘要
    借方合计
    贷方合计
    过账状态
  }

  entity "33. 凭证分录" as voucher_line {
    id <<PK>>
    凭证id <<FK>>
    --
    行号
    科目号
    科目名称
    借贷方向
    金额
    辅助核算维度
  }
}

' =====================================================
' 八、审批中介层（贯穿层 34–35）
' =====================================================
package "审批中介层" {

  entity "34. 审批申请单" as approval {
    id <<PK>>
    提交人id <<FK>>
    --
    申请单编号 <<BK>>
    审批类型
    合并模式
    流程定义编码
    流程实例id
    提交时间
    审批结论
    完成时间
    状态
  }

  entity "35. 审批单据明细" as approval_item {
    id <<PK>>
    审批申请单id <<FK>>
    业务单据类型
    业务单据id <<FK>>
    --
    行号
    行审批结论
    行执行状态
    失败原因
  }
}
